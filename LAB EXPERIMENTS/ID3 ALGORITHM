df["Attendance_Level"] = df["attendance"].apply(
    lambda x: "High" if x >= 80 else "Low"
)
df["Python_Level"] = df["python_marks"].apply(
    lambda x: "High" if x >= 75 else "Low"
)
df["ML_Level"] = df["ml_marks"].apply(
    lambda x: "High" if x >= 75 else "Low"
)
df["Project_Level"] = df["projects_completed"].apply(
    lambda x: "High" if x >= 3 else "Low"
)
def calculate_performance(row):
    average_marks = (
        row["attendance"]
        + row["python_marks"]
        + row["ml_marks"]
    ) / 3

    if average_marks >= 75 and row["projects_completed"] >= 3:
        return "Good"

    elif average_marks >= 60:
        return "Average"

    else:
        return "Poor"


df["Performance"] = df.apply(
    calculate_performance,
    axis=1
)
data = df[
    [
        "Attendance_Level",
        "Python_Level",
        "ML_Level",
        "Project_Level",
        "Performance"
    ]
]

print("\n")
