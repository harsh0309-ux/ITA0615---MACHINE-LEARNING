import numpy as np
import pandas as pd
 
rng = np.random.default_rng(42)
data = np.concatenate([rng.normal(2, 1.0, 150), rng.normal(8, 1.5, 100)])
pd.DataFrame({'value': data.round(4)}).to_csv('exp10_data.csv', index=False)
 
def pdf(x, mu, var):
    return np.exp(-(x - mu) ** 2 / (2 * var)) / np.sqrt(2 * np.pi * var)
 
# initial guess
mu = np.array([1.0, 5.0]); var = np.array([1.0, 1.0]); pi = np.array([0.5, 0.5])
 
for it in range(1, 51):
    # E-step : responsibilities
    resp = np.array([pi[k] * pdf(data, mu[k], var[k]) for k in range(2)])
    resp /= resp.sum(axis=0)
    # M-step : update parameters
    Nk = resp.sum(axis=1)
    mu = (resp * data).sum(axis=1) / Nk
    var = (resp * (data - mu[:, None]) ** 2).sum(axis=1) / Nk
    pi = Nk / len(data)
    if it in (1, 5, 10, 50):
        print(f"Iteration {it:2d}: mu = {mu.round(3)}  var = {var.round(3)}  pi = {pi.round(3)}")
 
print("\nEstimated means     :", mu.round(3))
print("Estimated variances :", var.round(3))
print("Mixing weights      :", pi.round(3))
