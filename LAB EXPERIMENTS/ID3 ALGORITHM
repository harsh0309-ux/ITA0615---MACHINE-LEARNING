print("GENERATED ID3 DECISION TREE")
print("=" * 60)

print(decision_tree)
def classify(tree, sample):

    if not isinstance(tree, dict):

        return tree

    attribute = next(iter(tree))

    value = sample[attribute]

    branch = tree[attribute].get(value)

    if branch is None:

        return "Unknown"

    return classify(
        branch,
        sample
    )
