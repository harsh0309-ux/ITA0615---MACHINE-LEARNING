import numpy as np
import pandas as pd
from sklearn.linear_model import LinearRegression
from sklearn.model_selection import train_test_split
from sklearn.metrics import mean_squared_error, r2_score
 
rng = np.random.default_rng(42)
exp = rng.uniform(0, 15, 100).round(1)
salary = (25000 + 4500 * exp + rng.normal(0, 4000, 100)).round(0)
df = pd.DataFrame({'YearsExperience': exp, 'Salary': salary})
df.to_csv('exp08_data.csv', index=False)
 
X_train, X_test, y_train, y_test = train_test_split(df[['YearsExperience']], df['Salary'], test_size=0.2, random_state=42)
model = LinearRegression().fit(X_train, y_train)
y_pred = model.predict(X_test)
 
print("Slope (m)     : %.2f" % model.coef_[0])
print("Intercept (c) : %.2f" % model.intercept_)
print("Mean Squared Error : %.2f" % mean_squared_error(y_test, y_pred))
print("R2 Score           : %.4f" % r2_score(y_test, y_pred))
print("Predicted salary for 10 years of experience : %.2f" %
      model.predict(pd.DataFrame({'YearsExperience': [10]}))[0])
